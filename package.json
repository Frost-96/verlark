{
  "name": "verlark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --no-warn-ignored src scripts tests *.ts *.mjs",
    "format": "prettier --write src scripts tests drizzle *.ts *.mjs package.json pnpm-workspace.yaml README.md",
    "format:check": "prettier --check src scripts tests drizzle *.ts *.mjs package.json pnpm-workspace.yaml README.md",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "prototype": "next dev --hostname 127.0.0.1 --port 3100"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.47.0",
    "next": "16.4.0",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.2.4",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25"
  }
}

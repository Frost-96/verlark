# Application PostgreSQL connection. Use a separate database for tests.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/verlark
# Only for isolated tests; database name MUST end in _test.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/verlark_test

# Verify private Blob store, free allowance and cleanup before enabling real uploads.
PRIVATE_RECORDINGS_ENABLED=false
RECORDING_UPLOADS_ENABLED=false
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
TESTER_EMAILS=you@example.com
# Local filesystem outbox .dev-mail/ only. Never enable in production.
DEVELOPMENT_MAIL=true

# Local development recording files only; blocked in production.
DEVELOPMENT_RECORDINGS=true

# 仅限 NODE_ENV=development/test；固定转写不是真实识别
DEVELOPMENT_TRANSCRIPTION=false

# 仅限 NODE_ENV=development/test；仅支持标注的固定样例，不是真实模型反馈
DEVELOPMENT_FEEDBACK=false

# Real feedback: disabled by default. Beijing workspace only, verified free-only stop.
REAL_FEEDBACK_ENABLED=false
FEEDBACK_FREE_ONLY_VERIFIED=false
# Fixed snapshot that passed the bounded quality evaluation; no automatic fallback.
FEEDBACK_MODEL=qwen3.8-max-0902
# Fill the exact selected model only after its own free-only checks, including the default.
FEEDBACK_FREE_MODEL_VERIFIED=
# Cumulative lifetime cap across every request in this database; never a monthly reset.
FEEDBACK_FREE_TOKEN_BUDGET=0
FEEDBACK_FREE_UNTIL=
# Real mail: QQ SMTP for the current trial. Never enable before credentials are ready.
MAIL_ENABLED=false
MAIL_PROVIDER=qq-smtp
# QQ authorization code, NOT the QQ account password. Server-only secrets.
QQ_SMTP_USER=
QQ_SMTP_AUTH_CODE=
# Resend-only settings, retained for an explicit future switch.
MAIL_FREE_PLAN_CONFIRMED=false
RESEND_API_KEY=
# QQ: must match QQ_SMTP_USER. Resend: own verified domain or owner-only test sender.
MAIL_FROM=
MAIL_DOMAIN_VERIFIED=false
MAIL_TEST_OWNER=
# Restored databases stay inaccessible until deletion replay and reconciliation finish.
MEDIA_RECOVERY_OFFLINE=false

# Real ASR: Beijing only; never enabled implicitly by API key presence.
BAILIAN_TRANSCRIPTION_ENABLED=false
DASHSCOPE_API_KEY=
# Set true ONLY after verifying this exact model's free-quota-only switch in console.
BAILIAN_ASR_FREE_ONLY_VERIFIED=false
# Lifetime allowance for this application's persistent ASR ledger (seconds).
# Includes all already committed ledger seconds; not a fresh remaining balance on restart.
# Reserve 120 seconds per request; actual valid usage settles; unknown retains 120.
# Account usage by other tools/apps must be subtracted before setting this ceiling.
BAILIAN_ASR_ALLOWANCE_SECONDS=0
BAILIAN_ASR_FREE_EXPIRES_AT=
# ASR permits the default Beijing host; real feedback requires the verified workspace
# ws-<id>.cn-beijing.maas.aliyuncs.com host. Both services share this setting.
DASHSCOPE_API_HOST=dashscope.aliyuncs.com

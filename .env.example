# Application PostgreSQL connection. Use a separate database for tests.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/verlark
# Only for isolated tests; database name MUST end in _test.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/verlark_test

# Verify private Blob store, free allowance and cleanup before enabling real uploads.
PRIVATE_RECORDINGS_ENABLED=false
RECORDING_UPLOADS_ENABLED=false
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
TESTER_EMAILS=you@example.com
# Local filesystem outbox .dev-mail/ only. Never enable in production.
DEVELOPMENT_MAIL=true

# Local development recording files only; blocked in production.
DEVELOPMENT_RECORDINGS=true

# 仅限 NODE_ENV=development/test；固定转写不是真实识别
DEVELOPMENT_TRANSCRIPTION=false

# 仅限 NODE_ENV=development/test；仅支持标注的固定样例，不是真实模型反馈
DEVELOPMENT_FEEDBACK=false

# Real feedback: disabled by default. Beijing workspace only, verified free-only stop.
REAL_FEEDBACK_ENABLED=false
FEEDBACK_FREE_ONLY_VERIFIED=false
# Cumulative lifetime cap across every request in this database; never a monthly reset.
FEEDBACK_FREE_TOKEN_BUDGET=0
FEEDBACK_FREE_UNTIL=
DASHSCOPE_API_KEY=
DASHSCOPE_API_HOST=
# Resend Free: enable only after account/free entitlement and recipient consent are verified.
MAIL_ENABLED=false
MAIL_FREE_PLAN_CONFIRMED=false
RESEND_API_KEY=
# Plain mailbox address. No verified domain: onboarding@resend.dev, owner only.
MAIL_FROM=
MAIL_DOMAIN_VERIFIED=false
MAIL_TEST_OWNER=
